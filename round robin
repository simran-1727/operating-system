n = int(input("Enter number of processes: "))

bt = []
for i in range(n):
    bt.append(int(input("Enter burst time for P" + str(i + 1) + ": ")))

q = int(input("Enter time quantum: "))

rem = bt.copy()
ct = [0] * n
tat = [0] * n
wt = [0] * n
rt = [0] * n

time = 0

while True:
    done = True

    for i in range(n):
        if rem[i] > 0:
            done = False

            if rem[i] > q:
                time += q
                rem[i] -= q
            else:
                time += rem[i]
                rem[i] = 0
                ct[i] = time

    if done:
        break

for i in range(n):
    tat[i] = ct[i]
    wt[i] = tat[i] - bt[i]
    rt[i] = wt[i]

print("\nProcess\tBT\tCT\tTAT\tWT\tRT")

for i in range(n):
    print("P" + str(i + 1), "\t", bt[i], "\t", ct[i],
          "\t", tat[i], "\t", wt[i], "\t", rt[i])

print("\nAverage Waiting Time =", sum(wt) / n)
print("Average Turnaround Time =", sum(tat) / n)
print("Average Response Time =", sum(rt) / n)
print("Average Completion Time =", sum(ct) / n)